# doc-cleaner environment variables
# Copy this to .env and fill in your values

# Gemini API key (required for --ai gemini)
GEMINI_API_KEY=

# Groq API key (required for --ai groq)
GROQ_API_KEY=

# PDF decryption password (optional, or use --password CLI arg)
PDF_PASSWORD=

# X (Twitter) authentication cookies (required for converting X articles)
X_AUTH_TOKEN=
X_CT0=

